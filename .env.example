# Phil, environment variables.
#
# None of these are required for local development, python3 seed.py and
# python3 run.py work with zero configuration. They matter once you deploy
# somewhere real (Railway or otherwise) and want the database to persist
# and card payments to work. Copy this file to `.env` for local reference
# only, real values belong in your host's dashboard (e.g. Railway's
# Variables tab), never committed to the repo.

# --- Database -----------------------------------------------------------
# Path to the SQLite file. On Railway, point this at a mounted volume
# (Settings > Volumes on the service, then mount it at e.g. /data) so the
# database survives redeploys instead of resetting every time.
PHIL_DB_PATH=/data/phil.db

# --- Server ---------------------------------------------------------------
# Railway sets PORT automatically, you don't need to set this yourself
# there. Only relevant for other hosts that don't inject it.
# PORT=8000

# --- Stripe (card payments) ----------------------------------------------
# From the Stripe dashboard, Developers > API keys. Use the sk_test_...
# key while testing, switch to sk_live_... only once you're ready for real
# charges.
STRIPE_SECRET_KEY=sk_test_...

# From Developers > Webhooks, after adding an endpoint pointing at
# https://<your-railway-domain>/webhooks/stripe with the events
# checkout.session.completed and customer.subscription.deleted selected.
STRIPE_WEBHOOK_SECRET=whsec_...

# From Products > (your product) > Pricing, the price ID (starts price_...)
# for the recurring school-plan price and, if you sell to individual
# mentors separately, the individual-plan price.
STRIPE_PRICE_ID_SCHOOL=price_...
STRIPE_PRICE_ID_INDIVIDUAL=price_...

# Your real domain once you have one pointed at Railway, used to build the
# URLs Stripe redirects back to after checkout. Falls back to
# http://localhost:8000 if unset, which is fine for local testing only.
APP_BASE_URL=https://app.phileducation.co.uk
